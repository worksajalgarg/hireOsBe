PORT=8000
# Gates whether app/main.py mounts the unauthenticated /dev/metrics
# dashboard (see dev_tools/metrics_dashboard.py) — must be "local",
# "development", or "dev" to mount; anything else (unset, "staging",
# "production", a typo) fails closed and does NOT mount it, since that
# dashboard serves raw candidate transcript/PII with zero auth when
# DEV_METRICS_ENABLED is also on.
APP_ENV="local"
LIVEKIT_URL="ws://localhost:7880"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="hireosdevsecret_do_not_use_in_prod"
OPENAI_API_KEY=""
# All four below power model_gateway's use_case_policy routing (see
# use_case_policy.py for which use case routes to which provider/model).
GEMINI_API_KEY=""
GROQ_API_KEY=""
OPENROUTER_API_KEY=""
# Which provider the voice_interview_turn/summary and role_discovery_turn/
# extraction use cases try first, second, third (see use_case_policy.py's
# apply_provider_priority(), applied once at worker startup — voice_agent/
# worker.py's main()). Comma-separated, no spaces required. Unset uses the
# built-in default (voice_agent/config.py's DEFAULT_LLM_PROVIDER_PRIORITY).
# Change this instead of hand-editing use_case_policy.py's hardcoded chains
# when you need to reprioritize (e.g. a provider's quota is exhausted, or
# once quotas recover and Groq-first latency matters more than availability).
VOICE_LLM_PROVIDER_PRIORITY="openrouter,gemini,groq"
# Powers voice_agent's STT/TTS (see session.py) — audio-only, not a reasoning
# surface, so these sit outside the model_gateway boundary by design.
# VOICE_PROVIDER=direct (default) uses these two keys directly.
# VOICE_PROVIDER=livekit_inference routes STT/TTS through LiveKit Cloud's
# bundled inference instead (billed via LIVEKIT_API_KEY/SECRET above) — the
# two keys below aren't needed in that mode.
VOICE_PROVIDER="direct"
DEEPGRAM_API_KEY=""
ELEVENLABS_API_KEY=""
# Dev-only /dev/metrics dashboard (see voice_agent/dev_metrics.py). Default
# off: when on, it writes raw candidate/interviewer speech (context_detail,
# live transcript) to a local file, bypassing the encrypted-storage/audit
# path real candidate data goes through — only enable on your own machine.
DEV_METRICS_ENABLED="false"

