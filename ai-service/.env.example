PORT=8000
AI_SERVICE_TOKEN=change-me-in-production

# mock = free local stub | openrouter = OpenAI-compatible | gemini = Google Gemini | local = transformers/torch
# Use mock for process testing when APIs have no quota/credits
LLM_MODE=mock
# Never persist synthetic mock data after a provider failure.
LLM_FALLBACK_TO_MOCK=false

# OpenRouter / OpenAI (LLM_MODE=openrouter)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openai/gpt-4o-mini
# OPENAI_MODEL=meta-llama/llama-3.2-3b-instruct:free
OPENAI_MAX_TOKENS=4096
ANTHROPIC_API_KEY=

# Gemini (LLM_MODE=gemini) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite

# Local NLP (LLM_MODE=local) — transformers + torch instruct model
LOCAL_LLM_MODEL=Qwen/Qwen2.5-3B-Instruct
LOCAL_LLM_MAX_NEW_TOKENS=4096
# auto | mps | cuda | cpu
LOCAL_LLM_DEVICE=auto

# Resume extractor
RESUME_MAX_UPLOAD_MB=10
RESUME_LLM_CHUNK_CHARS=12000
RESUME_LLM_MAX_CHUNKS=12
RESUME_SOURCE_MAX_CHARS=120000
CORS_ORIGINS=http://localhost:3000
# Docling: layout/OCR/tables only (not an LLM). Set true for fully scanned PDFs.
DOCLING_FORCE_FULL_PAGE_OCR=false
# Prefer local HuggingFace cache for Docling/local LLM models (set 0 for first-time download).
HF_HUB_OFFLINE=1

# Note: docling/easyocr/torch/transformers pull large deps on first install/run.
# pip install -r requirements.txt from ai-service/
# First Docling or local LLM run downloads models to ~/.cache/huggingface (needs network; HF_HUB_OFFLINE=0).
