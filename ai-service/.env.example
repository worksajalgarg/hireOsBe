PORT=8000

# mock = free local stub | openrouter = OpenAI-compatible | gemini = Google Gemini
# Use mock for process testing when APIs have no quota/credits
LLM_MODE=mock
# If gemini/openrouter fail (429/401/402), fall back to mock automatically
LLM_FALLBACK_TO_MOCK=true

# OpenRouter / OpenAI (LLM_MODE=openrouter)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openai/gpt-4o-mini
# OPENAI_MODEL=meta-llama/llama-3.2-3b-instruct:free
OPENAI_MAX_TOKENS=2048
ANTHROPIC_API_KEY=

# Gemini (LLM_MODE=gemini) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite

# Resume extractor
RESUME_MAX_UPLOAD_MB=10
CORS_ORIGINS=http://localhost:3000
# Docling: layout/OCR/tables only (not an LLM). Set true for fully scanned PDFs.
DOCLING_FORCE_FULL_PAGE_OCR=false
# Prefer local HuggingFace cache for Docling models (set 0 to allow first-time download).
HF_HUB_OFFLINE=1

# Note: docling/easyocr pull large deps on first install/run.
# pip install -r requirements.txt from ai-service/
# First Docling run downloads models to ~/.cache/huggingface (needs network; HF_HUB_OFFLINE=0).
