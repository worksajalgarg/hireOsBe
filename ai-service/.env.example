PORT=8000
LIVEKIT_URL="ws://localhost:7880"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="hireosdevsecret_do_not_use_in_prod"
OPENAI_API_KEY=""
# All four below power model_gateway's use_case_policy routing (see
# use_case_policy.py for which use case routes to which provider/model).
GEMINI_API_KEY=""
GROQ_API_KEY=""
OPENROUTER_API_KEY=""
# Powers voice_agent's STT/TTS (see session.py) — audio-only, not a reasoning
# surface, so these sit outside the model_gateway boundary by design.
# VOICE_PROVIDER=direct (default) uses these two keys directly.
# VOICE_PROVIDER=livekit_inference routes STT/TTS through LiveKit Cloud's
# bundled inference instead (billed via LIVEKIT_API_KEY/SECRET above) — the
# two keys below aren't needed in that mode.
VOICE_PROVIDER="direct"
DEEPGRAM_API_KEY=""
ELEVENLABS_API_KEY=""

