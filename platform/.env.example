DATABASE_URL="postgresql://platform:platform@localhost:5432/platform?schema=public"
REDIS_URL="rediss://default:password@your-instance.upstash.io:6379"
PORT=4000
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
COOKIE_SECURE="false"
CORS_ORIGIN="http://localhost:3000"
SEED_ADMIN_EMAIL="admin@hireos.local"
SEED_ADMIN_PASSWORD="Password123!"
LIVEKIT_URL="ws://localhost:7880"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="hireosdevsecret_do_not_use_in_prod"
# Must resolve from inside the livekit-egress container's docker network
# (compose service name), not from the host running this service.
MINIO_ENDPOINT="http://minio:9000"
MINIO_ACCESS_KEY="platform"
MINIO_SECRET_KEY="platform123"
RECORDINGS_BUCKET="interview-recordings"
# Shared secret authenticating ai-service's internal calls (e.g. POST
# /internal/interview-sessions/:id/transcript) — see
# common/internal-service.guard.ts and docs/adr/0006-interview-transcript-storage.md.
# Must match ai-service/.env's INTERNAL_SERVICE_SECRET exactly. Generate with
# e.g. `python3 -c "import secrets; print(secrets.token_hex(32))"`.
INTERNAL_SERVICE_SECRET="dev-internal-service-secret-change-me"
# ─── ai-service (resume/JD parsing) ───────────────────────────────────────────
AI_SERVICE_URL="http://localhost:8000"
AI_SERVICE_TIMEOUT_MS=45000
# ─── Object storage (resumes/JDs — reuses the MinIO creds above) ─────────────
RESUMES_BUCKET="candidate-resumes"
JD_BUCKET="job-descriptions"
S3_REGION="us-east-1"
S3_FORCE_PATH_STYLE="true"
