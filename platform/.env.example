DATABASE_URL="postgresql://platform:platform@localhost:5432/platform?schema=public"
PORT=4000
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
COOKIE_SECURE="false"
CORS_ORIGIN="http://localhost:3000"
SEED_ADMIN_EMAIL="admin@hireos.local"
SEED_ADMIN_PASSWORD="Password123!"

# MinIO / S3-compatible object storage (local docker-compose)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=platform
S3_SECRET_KEY=platform123
S3_BUCKET=hireos-resumes
S3_FORCE_PATH_STYLE=true

# AI service (resume extraction SSE proxy)
AI_SERVICE_URL=http://localhost:8000
RESUME_MAX_UPLOAD_MB=10
