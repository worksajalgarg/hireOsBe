generator client {
  provider = "prisma-client-js"
}

// Prisma 7: the connection URL is no longer read from this file at runtime.
// Migrate/introspection get it from prisma.config.ts; PrismaClient gets it
// via a driver adapter (see common/prisma.service.ts).
datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum ResumeStatus {
  UPLOADED
  EXTRACTING
  EXTRACTED
  FAILED
  EDITED
}

model Tenant {
  id           String   @id @default(uuid())
  name         String
  domain       String   @unique
  logoUrl      String?  @map("logo_url")
  settingsJson Json     @default("{}") @map("settings_json")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  policies     TenantPolicy[]
  roles        Role[]
  memberships  TenantUserRole[]
  sessions     UserSession[]
  invitations  TenantInvitation[]
  auditEvents  AuditEvent[]
  resumes      Resume[]

  @@map("tenants")
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String?    @map("password_hash")
  status       UserStatus @default(ACTIVE)
  ssoProvider  String?    @map("sso_provider")
  ssoId        String?    @map("sso_id")
  isMfaEnabled Boolean    @default(false) @map("is_mfa_enabled")
  lastLoginAt  DateTime?  @map("last_login_at")
  lastLoginIp  String?    @map("last_login_ip")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  profile             UserProfile?
  memberships         TenantUserRole[]
  sessions            UserSession[]
  passwordResetTokens PasswordResetToken[]
  invitationsSent     TenantInvitation[]   @relation("InvitationInviter")
  policiesUpdated     TenantPolicy[]       @relation("PolicyUpdater")
  resumesCreated      Resume[]             @relation("ResumeCreator")

  @@index([ssoProvider, ssoId])
  @@map("users")
}

model UserProfile {
  id              String  @id @default(uuid())
  userId          String  @unique @map("user_id")
  firstName       String? @map("first_name")
  lastName        String? @map("last_name")
  phone           String?
  avatarUrl       String? @map("avatar_url")
  jobTitle        String? @map("job_title")
  preferencesJson Json    @default("{}") @map("preferences_json")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Permission {
  id          String @id @default(uuid())
  slug        String @unique
  module      String
  description String

  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

model Role {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  name         String
  description  String?
  isSystemRole Boolean  @default(false) @map("is_system_role")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  memberships     TenantUserRole[]
  invitations     TenantInvitation[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("roles")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model TenantUserRole {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at")
  scopeJson  Json?    @map("scope_json")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
  @@map("tenant_user_roles")
}

model UserSession {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  tenantId         String   @map("tenant_id")
  refreshTokenHash String   @map("refresh_token_hash")
  userAgent        String?  @map("user_agent")
  ipAddress        String?  @map("ip_address")
  expiresAt        DateTime @map("expires_at")
  createdAt        DateTime @default(now()) @map("created_at")
  revokedAt        DateTime? @map("revoked_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
  @@index([refreshTokenHash])
  @@map("user_sessions")
}

model TenantPolicy {
  id                     String   @id @default(uuid())
  tenantId               String   @unique @map("tenant_id")
  retentionDays          Int      @default(90) @map("retention_days")
  audioStorageEnabled    Boolean  @default(false) @map("audio_storage_enabled")
  humanOverrideRequired  Boolean  @default(true) @map("human_override_required")
  updatedBy              String?  @map("updated_by")
  updatedAt              DateTime @updatedAt @map("updated_at")

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  updater User?  @relation("PolicyUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@map("tenant_policies")
}

model TenantInvitation {
  id              String           @id @default(uuid())
  tenantId        String           @map("tenant_id")
  email           String
  roleId          String           @map("role_id")
  tokenHash       String           @map("token_hash")
  status          InvitationStatus @default(PENDING)
  invitedBy       String           @map("invited_by")
  expiresAt       DateTime         @map("expires_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  acceptedAt      DateTime?        @map("accepted_at")

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role    Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)
  inviter User   @relation("InvitationInviter", fields: [invitedBy], references: [id], onDelete: Cascade)

  @@index([tenantId, email])
  @@index([tokenHash])
  @@map("tenant_invitations")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
  @@map("password_reset_tokens")
}

model Resume {
  id                 String       @id @default(uuid())
  tenantId           String       @map("tenant_id")
  createdByUserId    String       @map("created_by_user_id")
  originalFilename   String       @map("original_filename")
  contentType        String       @map("content_type")
  sizeBytes          Int          @map("size_bytes")
  storageKey         String       @map("storage_key")
  status             ResumeStatus @default(UPLOADED)
  extractedJson      Json?        @map("extracted_json")
  workingJson        Json?        @map("working_json")
  parseSource        String?      @map("parse_source")
  errorMessage       String?      @map("error_message")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User   @relation("ResumeCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@map("resumes")
}

/// Append-only. No application code should ever issue an UPDATE or DELETE
/// against this table — enforce that with a database role grant when a real
/// Postgres instance is provisioned (see docs/threat-model.md).
model AuditEvent {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  actorId    String   @map("actor_id")
  eventType  String   @map("event_type")
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  payload    Json
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, entityType, entityId])
  @@map("audit_events")
}
