generator client {
  provider = "prisma-client-js"
}

// Prisma 7: the connection URL is no longer read from this file at runtime.
// Migrate/introspection get it from prisma.config.ts; PrismaClient gets it
// via a driver adapter (see common/prisma.service.ts).
datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum InterviewSessionStatus {
  PENDING
  ACTIVE
  COMPLETED
  FAILED
}

enum JobRoleStatus {
  DRAFT
  OPEN
  ON_HOLD
  CLOSED
}

enum JdSourceType {
  UPLOAD
  PASTE
}

enum ExtractionStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

enum ResumeStatus {
  UPLOADED
  PARSING
  PARSED
  PARSE_FAILED
  QUARANTINED
}

enum ApplicationStage {
  APPLIED
  SCREENING
  SHORTLISTED
  INTERVIEW_SCHEDULED
  INTERVIEWED
  OFFER
}

enum ApplicationStatus {
  ACTIVE
  HIRED
  REJECTED
  WITHDRAWN
}

enum CandidateSource {
  RESUME_UPLOAD
  MANUAL
  REFERRAL
  IMPORT
}

model Tenant {
  id           String   @id @default(uuid())
  name         String
  domain       String   @unique
  logoUrl      String?  @map("logo_url")
  settingsJson Json     @default("{}") @map("settings_json")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  policies     TenantPolicy[]
  roles        Role[]
  memberships  TenantUserRole[]
  sessions     UserSession[]
  invitations  TenantInvitation[]
  auditEvents  AuditEvent[]
  interviewSessions InterviewSession[]
  promptTemplates   PromptTemplate[]
  jobRoles           JobRole[]
  jobRoleExtractions JobRoleExtraction[]
  candidates         Candidate[]
  resumes            Resume[]
  resumeExtractions  ResumeExtraction[]
  applications       Application[]
  applicationStageEvents ApplicationStageEvent[]

  @@map("tenants")
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String?    @map("password_hash")
  status       UserStatus @default(ACTIVE)
  ssoProvider  String?    @map("sso_provider")
  ssoId        String?    @map("sso_id")
  isMfaEnabled Boolean    @default(false) @map("is_mfa_enabled")
  lastLoginAt  DateTime?  @map("last_login_at")
  lastLoginIp  String?    @map("last_login_ip")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  profile             UserProfile?
  memberships         TenantUserRole[]
  sessions            UserSession[]
  passwordResetTokens PasswordResetToken[]
  invitationsSent     TenantInvitation[]   @relation("InvitationInviter")
  policiesUpdated     TenantPolicy[]       @relation("PolicyUpdater")
  jobRolesCreated     JobRole[]            @relation("JobRoleCreator")

  @@index([ssoProvider, ssoId])
  @@map("users")
}

model UserProfile {
  id              String  @id @default(uuid())
  userId          String  @unique @map("user_id")
  firstName       String? @map("first_name")
  lastName        String? @map("last_name")
  phone           String?
  avatarUrl       String? @map("avatar_url")
  jobTitle        String? @map("job_title")
  preferencesJson Json    @default("{}") @map("preferences_json")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Permission {
  id          String @id @default(uuid())
  slug        String @unique
  module      String
  description String

  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

model Role {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  name         String
  description  String?
  isSystemRole Boolean  @default(false) @map("is_system_role")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  memberships     TenantUserRole[]
  invitations     TenantInvitation[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("roles")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model TenantUserRole {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at")
  scopeJson  Json?    @map("scope_json")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
  @@map("tenant_user_roles")
}

model UserSession {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  tenantId         String   @map("tenant_id")
  refreshTokenHash String   @map("refresh_token_hash")
  userAgent        String?  @map("user_agent")
  ipAddress        String?  @map("ip_address")
  expiresAt        DateTime @map("expires_at")
  createdAt        DateTime @default(now()) @map("created_at")
  revokedAt        DateTime? @map("revoked_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
  @@index([refreshTokenHash])
  @@map("user_sessions")
}

model TenantPolicy {
  id                     String   @id @default(uuid())
  tenantId               String   @unique @map("tenant_id")
  retentionDays          Int      @default(90) @map("retention_days")
  audioStorageEnabled    Boolean  @default(false) @map("audio_storage_enabled")
  humanOverrideRequired  Boolean  @default(true) @map("human_override_required")
  updatedBy              String?  @map("updated_by")
  updatedAt              DateTime @updatedAt @map("updated_at")

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  updater User?  @relation("PolicyUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@map("tenant_policies")
}

model TenantInvitation {
  id              String           @id @default(uuid())
  tenantId        String           @map("tenant_id")
  email           String
  roleId          String           @map("role_id")
  tokenHash       String           @map("token_hash")
  status          InvitationStatus @default(PENDING)
  invitedBy       String           @map("invited_by")
  expiresAt       DateTime         @map("expires_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  acceptedAt      DateTime?        @map("accepted_at")

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role    Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)
  inviter User   @relation("InvitationInviter", fields: [invitedBy], references: [id], onDelete: Cascade)

  @@index([tenantId, email])
  @@index([tokenHash])
  @@map("tenant_invitations")
}

model PromptTemplate {
  id                  String   @id @default(uuid())
  tenantId            String   @map("tenant_id")
  title               String
  description         String?
  category            String   @default("Technical")
  conversationFlow    String?  @db.Text @map("conversation_flow")
  openingInstructions String?  @db.Text @map("opening_instructions")
  silenceInstructions String?  @db.Text @map("silence_instructions")
  systemBoundaries    String?  @db.Text @map("system_boundaries")
  isDefault           Boolean  @default(false) @map("is_default")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions  InterviewSession[]

  @@index([tenantId])
  @@map("prompt_templates")
}

/// LiveKit-backed AI voice interview session. `candidateRef` is a placeholder
/// free-text reference (no Candidate model exists yet — lands Sprint 3); this
/// stays a plain string until that model exists, at which point it becomes a
/// real FK.
model InterviewSession {
  id                 String                 @id @default(uuid())
  tenantId           String                 @map("tenant_id")
  candidateRef       String                 @map("candidate_ref")
  promptId           String?                @map("prompt_id")
  promptSnapshotJson Json?                  @map("prompt_snapshot_json")
  roomName           String                 @unique @map("room_name")
  inviteTokenHash    String                 @map("invite_token_hash")
  inviteExpiresAt    DateTime               @map("invite_expires_at")
  status             InterviewSessionStatus @default(PENDING)
  egressId           String?                @map("egress_id")
  recordingUrl       String?                @map("recording_url")
  startedAt          DateTime?              @map("started_at")
  endedAt            DateTime?              @map("ended_at")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  prompt PromptTemplate? @relation(fields: [promptId], references: [id], onDelete: SetNull)
  transcript InterviewTranscript?
  summary    InterviewSummary?
  application Application?

  @@index([tenantId])
  @@index([inviteTokenHash])
  @@map("interview_sessions")
}

/// Full transcript of a completed interview, pushed by ai-service's voice_agent
/// worker after the call ends (see docs/adr/0006-interview-transcript-storage.md).
/// One row per session — ai-service holds the whole conversation in memory for
/// the call's duration and sends it once at shutdown, not incrementally.
model InterviewTranscript {
  id                 String   @id @default(uuid())
  interviewSessionId String   @unique @map("interview_session_id")
  tenantId           String   @map("tenant_id")
  linesJson          Json     @map("lines_json") // [{speaker, text, stage?, ts}, ...]
  createdAt          DateTime @default(now()) @map("created_at")

  interviewSession InterviewSession @relation(fields: [interviewSessionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("interview_transcripts")
}

/// Structured post-call evaluation + operational metadata for one interview.
/// evaluationJson is an InterviewEvaluationSummary (see
/// common/types/interview-evaluation-summary.ts) — a scoped-down,
/// evidence-based shape (no bare score, ever) used until a real rubric/role
/// system exists to populate the full CandidateEvaluation type's
/// roleId/rubricVersion honestly.
model InterviewSummary {
  id                     String   @id @default(uuid())
  interviewSessionId     String   @unique @map("interview_session_id")
  tenantId               String   @map("tenant_id")
  rollingSummaryText     String?  @db.Text @map("rolling_summary_text")
  evaluationJson         Json     @map("evaluation_json")
  promptVersionsUsedJson Json     @map("prompt_versions_used_json")
  modelUsageJson         Json     @map("model_usage_json")
  createdAt              DateTime @default(now()) @map("created_at")

  interviewSession InterviewSession @relation(fields: [interviewSessionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("interview_summaries")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
  @@map("password_reset_tokens")
}

/// Append-only. No application code should ever issue an UPDATE or DELETE
/// against this table — enforce that with a database role grant when a real
/// Postgres instance is provisioned (see docs/threat-model.md).
model AuditEvent {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  actorId    String   @map("actor_id")
  eventType  String   @map("event_type")
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  payload    Json
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, entityType, entityId])
  @@map("audit_events")
}

/// A hiring requisition. NOT the RBAC `Role` model (table `roles`) — that is
/// permissions; this is a job opening. See docs/adr/0008-job-role-naming.md.
model JobRole {
  id             String        @id @default(uuid())
  tenantId       String        @map("tenant_id")
  title          String
  department     String?
  location       String?
  employmentType String?       @map("employment_type")
  seniority      String?
  status         JobRoleStatus @default(DRAFT)
  jdSourceType   JdSourceType  @map("jd_source_type")
  /// Raw JD text: the pasted body, or the text extracted from the uploaded
  /// file by ai-service. Employer-authored, not candidate PII.
  jdText         String?       @db.Text @map("jd_text")
  jdFileKey      String?       @map("jd_file_key")
  jdFileName     String?       @map("jd_file_name")
  jdMimeType     String?       @map("jd_mime_type")
  jdSizeBytes    Int?          @map("jd_size_bytes")
  /// The extraction currently treated as authoritative. Nullable: a role can
  /// exist before/without a successful parse.
  activeExtractionId String?   @unique @map("active_extraction_id")
  createdBy      String        @map("created_by")
  closedAt       DateTime?     @map("closed_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")

  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator          User               @relation("JobRoleCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  extractions      JobRoleExtraction[] @relation("JobRoleExtractions")
  activeExtraction JobRoleExtraction? @relation("JobRoleActiveExtraction", fields: [activeExtractionId], references: [id], onDelete: SetNull)
  applications     Application[]
  resumes          Resume[]           @relation("JobRoleResumes")

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("job_roles")
}

/// One attempt at structured extraction from a JD, produced by ai-service's
/// POST /role-intelligence/parse. extractionJson is a RoleExtractionResponse
/// (ai-service/app/agents/role_intelligence_schema.py) verbatim. Kept as a
/// separate table (not JSON columns on JobRole) so re-parsing an amended JD
/// keeps an auditable history.
model JobRoleExtraction {
  id             String           @id @default(uuid())
  tenantId       String           @map("tenant_id")
  jobRoleId      String           @map("job_role_id")
  attempt        Int              @default(1)
  status         ExtractionStatus @default(PENDING)
  extractionJson Json?            @map("extraction_json")
  modelVersion   String?          @map("model_version")
  errorCode      String?          @map("error_code")
  errorMessage   String?          @db.Text @map("error_message")
  startedAt      DateTime?        @map("started_at")
  completedAt    DateTime?        @map("completed_at")
  createdAt      DateTime         @default(now()) @map("created_at")

  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  jobRole   JobRole @relation("JobRoleExtractions", fields: [jobRoleId], references: [id], onDelete: Cascade)
  activeFor JobRole? @relation("JobRoleActiveExtraction")

  @@unique([jobRoleId, attempt])
  @@index([tenantId])
  @@index([jobRoleId, status])
  @@map("job_role_extractions")
}

model Candidate {
  id              String          @id @default(uuid())
  tenantId        String          @map("tenant_id")
  fullName        String          @map("full_name")
  primaryEmail    String?         @map("primary_email")
  /// lower(trim(primaryEmail)) — the dedupe key, written by the service
  /// layer. Uniqueness is a partial index (tenant_id, email_normalized)
  /// added by hand in this migration — Prisma can't express a WHERE clause.
  emailNormalized String?         @map("email_normalized")
  primaryPhone    String?         @map("primary_phone")
  currentTitle    String?         @map("current_title")
  location        String?
  source          CandidateSource @default(RESUME_UPLOAD)
  createdBy       String?         @map("created_by")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  deletedAt       DateTime?       @map("deleted_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  resumes      Resume[]
  applications Application[]

  @@index([tenantId])
  @@index([tenantId, emailNormalized])
  @@map("candidates")
}

model Resume {
  id                  String        @id @default(uuid())
  tenantId            String        @map("tenant_id")
  /// Nullable at upload time — the Candidate is created/matched only after
  /// parsing yields a name/email.
  candidateId         String?       @map("candidate_id")
  /// The role this resume was uploaded against — set at upload time,
  /// independent of the Application link (which only exists once parsing
  /// succeeds and a candidate is linked). Needed so "resumes for this role"
  /// can list resumes still UPLOADED/PARSING, not just fully-linked ones.
  jobRoleId           String?       @map("job_role_id")
  uploadedBy          String        @map("uploaded_by")
  /// S3/MinIO object key: `${tenantId}/resumes/${resumeId}/${slug}` —
  /// mirrors interviews/livekit.service.ts's `${tenantId}/${sessionId}/...`.
  storageKey          String        @unique @map("storage_key")
  originalFilename    String        @map("original_filename")
  mimeType            String        @map("mime_type")
  sizeBytes           Int           @map("size_bytes")
  checksumSha256      String        @map("checksum_sha256")
  status              ResumeStatus  @default(UPLOADED)
  extractedTextLength Int?          @map("extracted_text_length")
  activeExtractionId  String?       @unique @map("active_extraction_id")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")
  deletedAt           DateTime?     @map("deleted_at")

  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  candidate        Candidate?         @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  jobRole          JobRole?           @relation("JobRoleResumes", fields: [jobRoleId], references: [id], onDelete: SetNull)
  extractions      ResumeExtraction[] @relation("ResumeExtractions")
  activeExtraction ResumeExtraction?  @relation("ResumeActiveExtraction", fields: [activeExtractionId], references: [id], onDelete: SetNull)
  applications     Application[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([candidateId])
  @@index([tenantId, checksumSha256])
  @@index([jobRoleId])
  @@map("resumes")
}

/// One attempt at structured extraction from a resume, produced by
/// ai-service's POST /resume-intelligence/parse. extractionJson is a
/// ResumeExtractionResponse (resume_intelligence_schema.py) verbatim —
/// candidate PII (name, contact, employer history, verbatim quotes),
/// retained deliberately as the product data; covered by
/// TenantPolicy.retentionDays.
model ResumeExtraction {
  id             String           @id @default(uuid())
  tenantId       String           @map("tenant_id")
  resumeId       String           @map("resume_id")
  attempt        Int              @default(1)
  status         ExtractionStatus @default(PENDING)
  extractionJson Json?            @map("extraction_json")
  modelVersion   String?          @map("model_version")
  errorCode      String?          @map("error_code")
  errorMessage   String?          @db.Text @map("error_message")
  startedAt      DateTime?        @map("started_at")
  completedAt    DateTime?        @map("completed_at")
  createdAt      DateTime         @default(now()) @map("created_at")

  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  resume    Resume  @relation("ResumeExtractions", fields: [resumeId], references: [id], onDelete: Cascade)
  activeFor Resume? @relation("ResumeActiveExtraction")

  @@unique([resumeId, attempt])
  @@index([tenantId])
  @@index([resumeId, status])
  @@map("resume_extractions")
}

/// A candidate's presence in one job role's pipeline — the pairing carries
/// the stage, not the person, since a candidate can apply to more than one
/// role. Aligns with CandidateEvaluation's {candidateId, roleId} shape in
/// common/types/evaluation.ts.
model Application {
  id                 String            @id @default(uuid())
  tenantId           String            @map("tenant_id")
  candidateId        String            @map("candidate_id")
  jobRoleId          String            @map("job_role_id")
  resumeId           String?           @map("resume_id")
  stage              ApplicationStage  @default(APPLIED)
  status             ApplicationStatus @default(ACTIVE)
  stageEnteredAt     DateTime          @default(now()) @map("stage_entered_at")
  dispositionReason  String?           @db.Text @map("disposition_reason")
  assignedTo         String?           @map("assigned_to")
  /// Soft link to a voice interview — nullable, SetNull. candidateRef on
  /// InterviewSession stays a plain string (see that model's doc-comment);
  /// converting it to a real FK is separate follow-up work, not done here.
  interviewSessionId String?           @unique @map("interview_session_id")
  createdBy          String            @map("created_by")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  candidate        Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobRole          JobRole           @relation(fields: [jobRoleId], references: [id], onDelete: Cascade)
  resume           Resume?           @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  interviewSession InterviewSession? @relation(fields: [interviewSessionId], references: [id], onDelete: SetNull)
  stageEvents      ApplicationStageEvent[]

  @@unique([tenantId, candidateId, jobRoleId])
  @@index([tenantId])
  @@index([tenantId, jobRoleId, stage])
  @@index([tenantId, status])
  @@map("applications")
}

/// Append-only stage transition history — same posture as AuditEvent, never
/// UPDATEd or DELETEd.
model ApplicationStageEvent {
  id            String             @id @default(uuid())
  tenantId      String             @map("tenant_id")
  applicationId String             @map("application_id")
  fromStage     ApplicationStage?  @map("from_stage")
  toStage       ApplicationStage   @map("to_stage")
  fromStatus    ApplicationStatus? @map("from_status")
  toStatus      ApplicationStatus  @map("to_status")
  /// Nullable — a system/automation transition has no user actor.
  actorId       String?            @map("actor_id")
  note          String?            @db.Text
  createdAt     DateTime           @default(now()) @map("created_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([applicationId, createdAt])
  @@map("application_stage_events")
}
